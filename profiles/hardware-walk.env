# LSWTCS Switch runtime settings: copied to sdmc:/lswtcs/env.txt. One NAME=VALUE per line.
# Same flags as the PC launch (LSWTCSRuntime/build/boot_to_hub.sh launch_game). The Switch build is
# always single-view (no LSWTCS_SINGLEVIEW needed). Never set LSWTCS_AUTOSTART.
LSWTCS_COMPILE=1
LSWTCS_HEAPBYPASS=0
LSWTCS_SEMFIX=1
LSWTCS_STUBSRC=1
LSWTCS_RUNSHC=1
LSWTCS_GIL=1
LSWTCS_AE698EXIT=1
LSWTCS_SYNCREAD=1
LSWTCS_SPINGUARD=1
LSWTCS_WORKERGUARD=1
LSWTCS_BINDCLAMP=1
LSWTCS_GEOM=1
LSWTCS_PRISTINE=1
LSWTCS_FPS_CAP=60
LSWTCS_VCLOCK=0
# GAMEROOT disables fallback only; files already under /lswtcs, including movies, still resolve.
LSWTCS_GAMEROOT=X:/none/
# --- 2026-10-09: on by default in the build; listed so they can be switched off (=0) ---
# Pause the audio while the picture waits for shader builds (keeps cutscene sound in sync).
LSWTCS_AVHOLD=1
# Save shader GLSL to sdmc:/lswtcs/glprogs2 and prepare it in the background at boot.
LSWTCS_GLPROGLIST=1
# Capture combos, right stick clicked last: ZL + ZR = full (screenshot, per-draw log, render targets); L + R = light (no targets).
LSWTCS_CAPCOMBO=1

# W0 diagnostics; all other existing options preserved.
LSWTCS_FRAMELOG=1
LSWTCS_CAMLOG=0
LSWTCS_CAMCAPTURE=0
LSWTCS_CAMDUMP=0
LSWTCS_CPULOAD=0
LSWTCS_GLTIMING=0
# Every 600th replay, and every 120th in frames of 4000 draws or more, GPU timestamps after each draw: where the GPU's time goes. A brief hitch each time.
LSWTCS_GLGPUPROF=600
# In those frames also pixels per draw, for fill per program (the smoke of Episode I chapter 2).
LSWTCS_GLGPUPIX=1
LSWTCS_GLGPUSPLIT=0
LSWTCS_GLDIAG=1
LSWTCS_SCHEDPROF=1
LSWTCS_GLGPUSPAN=1

# Test session: settings change by themselves every 15 s, in a new order each round, so FPS and audio can be compared over the same scenes.
LSWTCS_ABCYCLE=15
# Each state differs from MAPXS in one thing, to compare one change at a time. M tile merging and A audio threads first stay on.
# P reuse of draw preparation, X XMA and LZ2K off the guest scheduler's turn, S resolves straight into stitched targets, H page hash per
# frame instead of per epoch (only this state: it can miss a page changed in mid-frame, and counts what it would have missed), V compares.
LSWTCS_ABSTATES=MAPXSHN,MAPXSHNW
# W: the PM4 walk off the guest turn, beside the render thread. Rejected in runs 7 and 12 (black tile bands, a picture that stopped); 0.0.23-log17 and 0.0.24-log18
# fixes a waiter that went on while the walker was off the turn again; log18 makes the tile drain wait for the tile worker's walk too. A separate session.
LSWTCS_WALKOFF_CORE=1
# In the V state, every 60 replays: the frame drawn merged, unmerged and merged again, then compared. The unmerged pass also resolves and
# stitches the old way, so this checks state S as well. Brief hitches there.
LSWTCS_GLUNTILECHECK=60
# The last 40 presented frames go out with a capture combo.
LSWTCS_GLHISTORY=40
# Guest frames of 250 ms or more say where the time went ([GSPIKE]).
LSWTCS_SPIKEMS=250
# Samples of each thread every 2 ms (hwprof.txt, tools/hwprof_report.py): where the guest CPU goes.
LSWTCS_HWPROF=2
# Pages hashed and walk and record time, every 60 frames ([GPUPAGES]).
LSWTCS_GPUPROFLOG=1
