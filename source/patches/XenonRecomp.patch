diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index fa91527..ae9a171 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -738,6 +738,23 @@ bool Recompiler::Recompile(
         println("\tif (!{}.eq) return;", cr(insn.operands[0]));
         break;
 
+    case PPC_INST_CROR:
+    case PPC_INST_CRORC:
+    case PPC_INST_CRMOVE:
+    {
+        // CR bit numbering: four bits per field, in lt/gt/eq/so order.
+        auto bit = [&](size_t index) {
+            static constexpr const char* fields[] = { "lt", "gt", "eq", "so" };
+            return fmt::format("{}.{}", cr(index / 4), fields[index & 3]);
+        };
+        if (id == PPC_INST_CRMOVE)
+            println("\t{} = {};", bit(insn.operands[0]), bit(insn.operands[1]));
+        else
+            println("\t{} = {} || {}{};", bit(insn.operands[0]), bit(insn.operands[1]),
+                id == PPC_INST_CRORC ? "!" : "", bit(insn.operands[2]));
+        break;
+    }
+
     case PPC_INST_CCTPL:
         // no op
         break;
@@ -1740,6 +1757,10 @@ bool Recompiler::Recompile(
         println("\tsimde_mm_store_ps({}.f32, simde_mm_add_ps(simde_mm_load_ps({}.f32), simde_mm_load_ps({}.f32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
 
+    case PPC_INST_VADDSBS:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_adds_epi8(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
     case PPC_INST_VADDSHS:
         println("\tsimde_mm_store_si128((simde__m128i*){}.s16, simde_mm_adds_epi16(simde_mm_load_si128((simde__m128i*){}.s16), simde_mm_load_si128((simde__m128i*){}.s16)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
@@ -1769,6 +1790,7 @@ bool Recompiler::Recompile(
         println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_and_si128(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
 
+    case PPC_INST_VANDC:
     case PPC_INST_VANDC128:
         println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_andnot_si128(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[2]), v(insn.operands[1]));
         break;
@@ -1848,6 +1870,12 @@ bool Recompiler::Recompile(
             println("\t{}.setFromMask(simde_mm_load_si128((simde__m128i*){}.u8), 0xFFFF);", cr(6), v(insn.operands[0]));
         break;
 
+    case PPC_INST_VCMPEQUH:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_cmpeq_epi16(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.setFromMask(simde_mm_load_si128((simde__m128i*){}.u8), 0xFFFF);", cr(6), v(insn.operands[0]));
+        break;
+
     case PPC_INST_VCMPEQUW:
     case PPC_INST_VCMPEQUW128:
         println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_cmpeq_epi32(simde_mm_load_si128((simde__m128i*){}.u32), simde_mm_load_si128((simde__m128i*){}.u32)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
@@ -1871,6 +1899,35 @@ bool Recompiler::Recompile(
             println("\t{}.setFromMask(simde_mm_load_ps({}.f32), 0xF);", cr(6), v(insn.operands[0]));
         break;
 
+    case PPC_INST_VCMPGTSH:
+    case PPC_INST_VCMPGTSW:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, {}(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));",
+            v(insn.operands[0]), id == PPC_INST_VCMPGTSH ? "simde_mm_cmpgt_epi16" : "simde_mm_cmpgt_epi32", v(insn.operands[1]), v(insn.operands[2]));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.setFromMask(simde_mm_load_si128((simde__m128i*){}.u8), 0xFFFF);", cr(6), v(insn.operands[0]));
+        break;
+
+    case PPC_INST_VMAXSH:
+    case PPC_INST_VMINSH:
+    case PPC_INST_VSUBSHS:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, {}(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));",
+            v(insn.operands[0]), id == PPC_INST_VMAXSH ? "simde_mm_max_epi16" : id == PPC_INST_VMINSH ? "simde_mm_min_epi16" : "simde_mm_subs_epi16", v(insn.operands[1]), v(insn.operands[2]));
+        break;
+
+    case PPC_INST_VSLH:
+    case PPC_INST_VSRAH:
+        for (size_t i = 0; i < 8; ++i)
+            println("\t{}.{}16[{}] = {}.{}16[{}] {} ({}.u16[{}] & 15);",
+                v(insn.operands[0]), id == PPC_INST_VSLH ? "u" : "s", i,
+                v(insn.operands[1]), id == PPC_INST_VSLH ? "u" : "s", i,
+                id == PPC_INST_VSLH ? "<<" : ">>", v(insn.operands[2]), i);
+        break;
+
+    case PPC_INST_VSPLTISH:
+        println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_set1_epi16({}));",
+            v(insn.operands[0]), (int(insn.operands[1] & 31) ^ 16) - 16);
+        break;
+
     case PPC_INST_VCMPGTUB:
         println("\tsimde_mm_store_si128((simde__m128i*){}.u8, simde_mm_cmpgt_epu8(simde_mm_load_si128((simde__m128i*){}.u8), simde_mm_load_si128((simde__m128i*){}.u8)));", v(insn.operands[0]), v(insn.operands[1]), v(insn.operands[2]));
         break;
