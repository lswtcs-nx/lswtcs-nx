# LSWTCS player profile. Built into the NRO since log107 and used when sdmc:/lswtcs/env.txt is absent; copy it there only
# to change a setting (an env.txt replaces the built-in settings whole). One NAME=VALUE per line.
# The settings of profiles/hardware-ab.env that change how the game runs, with the diagnostics off: no sampling profiler,
# no per-frame log, no GPU timestamps, no capture combos, no periodic render reports, no object-trigger log. The game still
# writes a short stdout.log (boot lines, [CLOCK] every 5 s, errors). Never set LSWTCS_AUTOSTART.
# Flags whose default is off are left out on purpose: some are tested for presence, not value (LSWTCS_GPUPROFLOG).

# Runtime fixes and guest code settings (as in every measured session).
LSWTCS_COMPILE=1
LSWTCS_HEAPBYPASS=0
LSWTCS_SEMFIX=1
LSWTCS_STUBSRC=1
LSWTCS_RUNSHC=1
LSWTCS_GIL=1
LSWTCS_AE698EXIT=1
LSWTCS_SYNCREAD=1
LSWTCS_SPINGUARD=1
LSWTCS_WORKERGUARD=1
LSWTCS_BINDCLAMP=1
LSWTCS_GEOM=1
LSWTCS_PRISTINE=1
LSWTCS_FPS_CAP=60
LSWTCS_VCLOCK=0

# GAMEROOT disables fallback only; files already under /lswtcs, including movies, still resolve.
LSWTCS_GAMEROOT=X:/none/

# Audio waits for shader builds; shader GLSL kept on the card and prepared at boot.
LSWTCS_AVHOLD=1
LSWTCS_GLPROGLIST=1

# Renderer and threads: one draw pass per frame, the walker on core 1, real guest locks, thread placement guard, core 3 when allowed.
LSWTCS_ONETILE=1
LSWTCS_WALKOFF_CORE=1
LSWTCS_SPINREAL=1
LSWTCS_PLACEGUARD=1
LSWTCS_CORE3=1

# The tuned feature set. The letters are applied by the A/B cycle, so it stays on with one state (it only re-applies the same
# state every 6 s). Without LSWTCS_ABCYCLE the letters would not be applied at all.
LSWTCS_ABCYCLE=6
LSWTCS_ABSTATES=MAPXSHNLUBIkhwregdq
LSWTCS_LOADMODES=-

# Controls: face buttons by label in menus and by position in play (L + R + Minus cycles); two players (L + R + Plus: controller screen).
LSWTCS_PADLAYOUT=auto
LSWTCS_PLAYERS=2

# Diagnostics off (their defaults are on).
LSWTCS_FRAMELOG=0
LSWTCS_GLDIAG=0
LSWTCS_OBJLOG=0
LSWTCS_CAPCOMBO=0
# The handheld GPU runs at 460.8 MHz by default (official configuration 0x92220008). LSWTCS_GPUBOOST=0 keeps 307.2 MHz.
# Keep LSWTCS_CLOCKLOG unset or above 0: the clock monitor thread is what applies that configuration and checks the memory clock.
