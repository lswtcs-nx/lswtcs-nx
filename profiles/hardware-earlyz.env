# LSWTCS Switch runtime settings: copied to sdmc:/lswtcs/env.txt. One NAME=VALUE per line.
# Same flags as the PC launch (LSWTCSRuntime/build/boot_to_hub.sh launch_game). The Switch build is
# always single-view (no LSWTCS_SINGLEVIEW needed). Never set LSWTCS_AUTOSTART.
LSWTCS_COMPILE=1
LSWTCS_HEAPBYPASS=0
LSWTCS_SEMFIX=1
LSWTCS_STUBSRC=1
LSWTCS_RUNSHC=1
LSWTCS_GIL=1
LSWTCS_AE698EXIT=1
LSWTCS_SYNCREAD=1
LSWTCS_SPINGUARD=1
LSWTCS_WORKERGUARD=1
LSWTCS_BINDCLAMP=1
LSWTCS_GEOM=1
LSWTCS_PRISTINE=1
LSWTCS_FPS_CAP=60
LSWTCS_VCLOCK=0
# GAMEROOT disables fallback only; files already under /lswtcs, including movies, still resolve.
LSWTCS_GAMEROOT=X:/none/
# --- 2026-10-09: on by default in the build; listed so they can be switched off (=0) ---
# Pause the audio while the picture waits for shader builds (keeps cutscene sound in sync).
LSWTCS_AVHOLD=1
# Save shader GLSL to sdmc:/lswtcs/glprogs2 and prepare it in the background at boot.
LSWTCS_GLPROGLIST=1
# Capture combo: hold ZL + ZR and click the right stick -> screenshot + per-draw log + render-target dump.
LSWTCS_CAPCOMBO=1

# W0 diagnostics; all other existing options preserved.
LSWTCS_FRAMELOG=1
LSWTCS_CAMLOG=0
LSWTCS_CAMCAPTURE=0
LSWTCS_CAMDUMP=0
LSWTCS_CPULOAD=0
LSWTCS_GLTIMING=0
LSWTCS_GLGPUPROF=0
LSWTCS_GLGPUSPLIT=0
LSWTCS_GLDIAG=1
LSWTCS_SCHEDPROF=1
LSWTCS_GLGPUSPAN=1

# Early-Z check: per-draw GPU timestamps every 300th replay, no deliberately wrong frames.
# LSWTCS_GLEARLYZ=0 restores the previous shaders for an A/B run.
LSWTCS_GLGPUPROF=300
