# log122: the translation cache's identity (gl_xlate_cache.cc), from the files that decide a translation's GLSL, instead
# of the NRO's build ID, which changed with every rebuild of anything and started xlate.bin over each time (run 120's
# worst frame, 2.1 s). Run with -DLIST=<file listing the inputs, one per line> -DOUT=<header to write>.
# The header is rewritten only when the value changes, so nothing is rebuilt for nothing.
file(STRINGS "${LIST}" files)
set(all "")
foreach(f IN LISTS files)
  if(EXISTS "${f}")
    file(SHA256 "${f}" h)
    get_filename_component(name "${f}" NAME)
    string(APPEND all "${name} ${h}\n")
  endif()
endforeach()
string(SHA256 id "${all}")
string(SUBSTRING "${id}" 0 32 id)
set(text "// Generated by tools/xlate_identity.cmake: the translator's sources and headers (log122).\n#define LSW_XLATE_IDENTITY \"${id}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
